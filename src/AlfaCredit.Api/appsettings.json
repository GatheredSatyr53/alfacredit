{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=alfacredit;Username=alfacredit;Password=alfacredit"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "AlfaCredit",
    "Audience": "AlfaCredit",
    "LifetimeMinutes": 480
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "Enabled": true,
    "DemoPassword": "Demo123!"
  },
  "Cors": {
    "Origins": "http://localhost:5173,http://localhost:3000"
  },
  "Swagger": {
    "Enabled": true
  },
  "RateLimiting": {
    "LoginPermitLimit": 20,
    "LoginWindowSeconds": 60
  },
  "Processing": {
    "StageDelaySeconds": 2,
    "WorkerCount": 2,
    "PollIntervalMs": 500,
    "MaxAttempts": 3,
    "RetryDelaySeconds": 2,
    "OfferExpiryCheckSeconds": 60,
    "LeaseSeconds": 120
  },
  "DecisionPolicy": {
    "OfferValidityDays": 7,
    "MaxAmountShareOfRevenue": 0.25,
    "TaxDebtHardStopRub": 500000,
    "FsspHardStopRub": 1000000,
    "OverdueDaysHardStop": 90
  },
  "Scoring": {
    "Mode": "Rules",
    "BaseUrl": "http://scoring:8000",
    "TimeoutSeconds": 5,
    "Retries": 2,
    "RetryDelayMs": 1000
  },
  "Simulators": {
    "FailureRate": 0.0,
    "LatencyMs": 150
  },
  "DemoManager": {
    "Enabled": true,
    "DelaySeconds": 8,
    "ApprovalProbability": 0.5
  },
  "Contracts": {
    "SigningDays": 5,
    "CodeTtlMinutes": 10,
    "CodeMaxAttempts": 5,
    "RevealCodeInResponse": true,
    "LenderName": "AlfaCredit (демонстрационный банк)"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
