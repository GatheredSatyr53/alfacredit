# Скопируйте в .env при необходимости: docker compose читает его автоматически.
# У всех переменных есть значения по умолчанию в docker-compose.yml, для демо файл .env не обязателен.

# PostgreSQL
POSTGRES_DB=alfacredit
POSTGRES_USER=alfacredit
POSTGRES_PASSWORD=alfacredit

# Порт API на хосте (Swagger: http://localhost:8080/swagger)
API_PORT=8080

# Порт сервиса скоринга на хосте, только для отладки (curl localhost:8000/health)
SCORING_PORT=8000

# Секрет подписи JWT. Для демо есть значение по умолчанию, для любого внешнего стенда задайте свой (не короче 32 символов).
JWT_KEY=change-me-to-a-random-string-at-least-32-characters-long

# Пароль всех демо-учёток, которые создаёт seed
SEED_DEMO_PASSWORD=Demo123!

# Разрешённые origin фронтенда, через запятую
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Задержка каждого этапа конвейера в секундах (чтобы на демо было видно движение заявки)
PROCESSING_STAGE_DELAY_SECONDS=2

# Вероятность сбоя симуляторов внешних источников (0..1): показывает ретраи и передачу менеджеру
SIMULATORS_FAILURE_RATE=0

# Скоринг: External (сервис scoring по docs/scoring-contract.md с откатом на встроенную модель) или Rules (только встроенная модель)
SCORING_MODE=External
SCORING_BASE_URL=http://scoring:8000
# Таймаут одного запроса к скорингу и число повторов (паузы 1 с и 2 с); после них считает встроенная модель
SCORING_TIMEOUT_SECONDS=5
SCORING_RETRIES=2
