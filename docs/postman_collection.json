{
  "info": {
    "name": "AlfaCredit API",
    "description": "Кредитный конвейер для малого и микробизнеса. Переменные: baseUrl, login, password; token, companyId и applicationId заполняются автоматически после запросов Login, My companies и Create application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "login",
      "value": "client_good"
    },
    {
      "key": "password",
      "value": "Demo123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "companyId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Live",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/live"
          }
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Login with wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"client_good\",\n  \"password\": \"wrong-password\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "Product by code",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/working-capital"
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "My companies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/companies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('companyId', pm.response.json()[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Statuses catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/applications/statuses"
          }
        },
        {
          "name": "Financing preview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/financing/preview",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"amount\": 1500000,\n  \"purpose\": \"WorkingCapital\",\n  \"needByDate\": \"2026-11-15\",\n  \"termMonths\": 12\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has recommended option', () => pm.expect(pm.response.json().options[0].isRecommended).to.eql(true));",
                  "pm.test('no application created', () => pm.expect(pm.response.json().disclaimer).to.include('Заявка не создана'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"productCode\": \"working-capital\",\n  \"amount\": 1500000,\n  \"termMonths\": 12,\n  \"purpose\": \"WorkingCapital\",\n  \"purposeDescription\": \"Закупка товара к сезону\",\n  \"needByDate\": \"2026-11-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('applicationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get application",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}"
          }
        },
        {
          "name": "List my applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications?page=1&pageSize=20"
          }
        },
        {
          "name": "Accept offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/offer/accept"
          }
        },
        {
          "name": "Decline offer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/offer/decline",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Нашли предложение с меньшей ставкой\"\n}"
            }
          }
        },
        {
          "name": "Get contract",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/contract"
          }
        },
        {
          "name": "Contract document (HTML)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/contract/document"
          }
        },
        {
          "name": "Request signing code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/contract/sign/request-code"
          }
        },
        {
          "name": "Sign contract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/contract/sign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"483921\"\n}"
            }
          }
        },
        {
          "name": "Cancel application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Нашли другой источник финансирования\"\n}"
            }
          }
        },
        {
          "name": "Validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/applications",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"productCode\": \"overdraft\",\n  \"amount\": 50000000,\n  \"termMonths\": 60,\n  \"purpose\": \"Equipment\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Feed",
      "item": [
        {
          "name": "List feed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/feed?page=1&pageSize=20"
          }
        },
        {
          "name": "Unread count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/feed/unread-count"
          }
        },
        {
          "name": "Mark all read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/feed/read-all"
          }
        }
      ]
    }
  ]
}
